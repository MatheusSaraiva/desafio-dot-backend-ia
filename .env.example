# Copie para .env e preencha. O arquivo .env está no .gitignore.

# --- Questão 2: chatbot (LangChain + OpenAI ou DeepSeek) ---
# Modelo no formato provedor:modelo. O enunciado cita GPT-4 (hoje legado); o padrão é o
# gpt-5.4-mini da OpenAI (US$ 0,75/4,50 por 1M tokens). Outras opções:
#   openai:gpt-6.1-terra   (US$ 1/5, boa escrita)     openai:gpt-6-luna (US$ 0,10/0,50)
#   deepseek:deepseek-flash (API compatível com a da OpenAI; precisa de DEEPSEEK_API_KEY)
LLM_MODEL=openai:gpt-5.4-mini
# Só a chave do provedor escolhido é obrigatória. Os testes automatizados rodam SEM chave.
OPENAI_API_KEY=coloque-sua-chave-aqui
DEEPSEEK_API_KEY=

# --- LangSmith (opcional, recomendado): tracing de cada conversa ---
# Preencha a chave e mude para true. Com a chave vazia o tracing fica desligado.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=coloque-sua-chave-aqui
LANGSMITH_PROJECT=dot-chatbot-python

# --- Questão 3: busca semântica ---
# Modelo de embeddings (HuggingFace). Pequeno e bom em português; troque por BAAI/bge-m3 para mais qualidade.
EMBEDDING_MODEL=intfloat/multilingual-e5-small
# Cosseno mínimo para um trecho entrar no RAG do chatbot (calibrado para o e5-small; veja `make evaluate`).
SCORE_MINIMO=0.837

# --- Questão 1: API Django ---
DJANGO_SECRET_KEY=troque-esta-chave-fora-do-ambiente-local
DJANGO_DEBUG=true
