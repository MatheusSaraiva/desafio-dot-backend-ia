# Copie para .env e preencha. O arquivo .env está no .gitignore.

# --- Questão 2: chatbot (LangChain + OpenAI) ---
# Obrigatório para respostas reais. Os testes automatizados rodam SEM chave (LLM simulado).
OPENAI_API_KEY=coloque-sua-chave-aqui
# Modelo configurável: o enunciado cita GPT-4 (hoje legado). Default: gpt-5.4-mini (US$ 0,75/4,50 por 1M tokens).
# Alternativas da geração atual: gpt-6.1-terra (US$ 1/5, boa escrita) ou gpt-6-luna (US$ 0,10/0,50, o mais barato).
OPENAI_MODEL=gpt-5.4-mini

# --- LangSmith (opcional, recomendado): tracing de cada conversa ---
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=coloque-sua-chave-aqui
LANGSMITH_PROJECT=dot-chatbot-python

# --- Questão 3: busca semântica ---
# Modelo de embeddings (HuggingFace). Pequeno e bom em português; troque por BAAI/bge-m3 para mais qualidade.
EMBEDDING_MODEL=intfloat/multilingual-e5-small

# --- Questão 1: API Django ---
DJANGO_SECRET_KEY=troque-esta-chave-fora-do-ambiente-local
DJANGO_DEBUG=true
